# ============================================
# CONFIGURAÇÃO PARA DESENVOLVIMENTO LOCAL
# ============================================

# App
APP_NAME=Autobiz
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Segurança
SECRET_KEY=chave-secreta-desenvolvimento-nao-usar-em-producao
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Banco de Dados Local
DATABASE_URL=postgresql://autobiz:autobiz@localhost:5432/autobiz

# Redis Local
REDIS_URL=redis://localhost:6379/0

# Frontend Local
FRONTEND_URL=http://localhost:5173

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# Plugins
PLUGINS_DIR=./plugins

# Admin Master
ADMIN_MASTER_EMAIL=admin@autobiz.com
ADMIN_MASTER_PASSWORD=admin123

# Tenant
DEFAULT_TENANT_PLAN=free
TENANT_SUBDOMAIN_ENABLED=true
