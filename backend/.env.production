# ============================================
# CONFIGURAÇÃO PARA SUPABASE + VERCEL
# ============================================

# App
APP_NAME=Autobiz
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# Segurança
SECRET_KEY=sua-chave-super-secreta-aqui-mude-isso-123456789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# SUPABASE - BANCO DE DADOS
# ============================================
# Substitua SENHA pela senha do seu Supabase
# Substitua XXXX pelo ID do seu projeto Supabase
DATABASE_URL=postgresql://postgres:SENHA@db.XXXX.supabase.co:5432/postgres

# Redis (não usamos no deploy gratuito)
REDIS_URL=redis://localhost:6379/0

# ============================================
# INTEGRAÇÕES (OPCIONAL - configure depois)
# ============================================
# OPENAI_API_KEY=
# MERCADOPAGO_ACCESS_TOKEN=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# SMTP_USER=
# SMTP_PASSWORD=

# ============================================
# FRONTEND - URL DO VERCEL
# ============================================
# Substitua SEU-APP pelo nome do seu app no Vercel
FRONTEND_URL=https://SEU-APP.vercel.app

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# Plugins
PLUGINS_DIR=./plugins

# Admin Master
ADMIN_MASTER_EMAIL=admin@autobiz.com
ADMIN_MASTER_PASSWORD=admin123

# Tenant
DEFAULT_TENANT_PLAN=free
TENANT_SUBDOMAIN_ENABLED=false
